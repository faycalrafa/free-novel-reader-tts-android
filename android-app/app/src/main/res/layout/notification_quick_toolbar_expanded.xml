<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_quick_toolbar_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="96dp"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="2dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <!-- Top Row: Title, Status, Close Button (iv_toolbar_icon_exp gone to maximize text width) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_toolbar_icon_exp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:contentDescription="NovelArrow Reader"
            android:src="@drawable/ic_notification_toolbar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_novel_title_exp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="NovelArrow Reader"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_chapter_status_exp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ready to Read"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/btn_close_exp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="Close Toolbar"
            android:scaleType="centerInside"
            android:padding="4dp"
            android:src="@drawable/ic_notification_toolbar_close" />
    </LinearLayout>

    <!-- Divider Line: FrameLayout has @RemoteView annotation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#263345" />

    <!-- Bottom Row: Action Controls with Roomy Spacing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Speed Pill Button -->
        <TextView
            android:id="@+id/btn_speed_exp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="1.0x"
            android:textColor="#F1F5F9"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Sleep Timer Pill Button -->
        <TextView
            android:id="@+id/btn_sleep_timer_exp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="💤 Off"
            android:textColor="#F1F5F9"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Weight Spacer: FrameLayout has @RemoteView annotation -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Previous Chapter -->
        <ImageButton
            android:id="@+id/btn_prev_chap_exp"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="Previous Chapter"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:src="@drawable/ic_toolbar_prev" />

        <!-- Play / Pause Button with Accent Purple Circular Background -->
        <ImageButton
            android:id="@+id/btn_play_pause_exp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_toolbar_play_bg"
            android:contentDescription="Play or Pause"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:src="@drawable/ic_toolbar_play" />

        <!-- Next Chapter -->
        <ImageButton
            android:id="@+id/btn_next_chap_exp"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="Next Chapter"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:src="@drawable/ic_toolbar_next" />

        <!-- Site Next Chapter -->
        <ImageButton
            android:id="@+id/btn_site_next_exp"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Site Next Chapter"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:src="@drawable/ic_toolbar_site_next" />
    </LinearLayout>

</LinearLayout>
