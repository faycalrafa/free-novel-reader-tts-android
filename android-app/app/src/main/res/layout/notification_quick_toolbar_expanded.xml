<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_quick_toolbar_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    android:background="@drawable/bg_notification_toolbar"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Top Row: Icon, Title, Status, Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_toolbar_icon_exp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="NovelArrow Reader"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_novel_title_exp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="NovelArrow Reader"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_chapter_status_exp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ready to Read"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/btn_close_exp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="Close Toolbar"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#1E293B" />

    <!-- Bottom Row: Action Controls with Roomy Spacing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Speed Pill Button -->
        <TextView
            android:id="@+id/btn_speed_exp"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Sleep Timer Pill Button -->
        <TextView
            android:id="@+id/btn_sleep_timer_exp"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="💤 Off"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Previous Chapter -->
        <ImageButton
            android:id="@+id/btn_prev_chap_exp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Previous Chapter"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_previous" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Play / Pause Button -->
        <ImageButton
            android:id="@+id/btn_play_pause_exp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Play or Pause"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Next Chapter -->
        <ImageButton
            android:id="@+id/btn_next_chap_exp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Next Chapter"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_next" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Site Next Chapter -->
        <ImageButton
            android:id="@+id/btn_site_next_exp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Site Next Chapter"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_ff" />
    </LinearLayout>

</LinearLayout>
