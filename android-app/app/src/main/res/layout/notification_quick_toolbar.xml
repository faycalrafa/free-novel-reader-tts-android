<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_quick_toolbar_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_notification_toolbar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/iv_toolbar_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="NovelArrow Reader"
        android:src="@drawable/ic_notification_toolbar" />

    <!-- Info Column (Title & Chapter Progress) -->
    <LinearLayout
        android:id="@+id/layout_toolbar_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_novel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NovelArrow Reader"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_chapter_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Resume Reading"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/layout_toolbar_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Speed Pill Button -->
        <TextView
            android:id="@+id/btn_speed"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Sleep Timer Pill Button -->
        <TextView
            android:id="@+id/btn_sleep_timer"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:text="💤 Off"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Previous Chapter -->
        <ImageButton
            android:id="@+id/btn_prev_chap"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="Previous Chapter"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_previous" />

        <!-- Play / Pause -->
        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Play or Pause"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play" />

        <!-- Next Chapter -->
        <ImageButton
            android:id="@+id/btn_next_chap"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="Next Chapter"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_next" />

        <!-- Site Next Chapter -->
        <ImageButton
            android:id="@+id/btn_site_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="Site Next Chapter"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_ff" />

        <!-- Close / Dismiss Toolbar -->
        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="Close Toolbar"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notification_toolbar_close" />
    </LinearLayout>

</LinearLayout>
